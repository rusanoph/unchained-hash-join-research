+        while(count>1) {swap(begin,begin+count-1);sift(begin,0,--count);}
+    }
+    void sort(uint64_t begin,uint64_t end,unsigned depth) {
+        while(end-begin>1) {
+            if(!depth) {heap(begin,end);return;}
+            --depth;auto a=key(begin),b=key(begin+(end-begin)/2),c=key(end-1);
+            if(less(b,a))std::swap(a,b);
+            if(less(c,b))std::swap(b,c);
+            if(less(b,a))std::swap(a,b);
+            const auto pivot=b;auto lower=begin,current=begin,upper=end;
+            while(current<upper) {
+                const auto value=key(current);
+                if(less(value,pivot)) {swap(current++,lower++);}
+                else if(less(pivot,value))swap(current,--upper);
+                else ++current;
+            }
+            // Recurse into only the smaller partition: bounded O(log n) stack.
+            if(lower-begin<end-upper) {sort(begin,lower,depth);begin=upper;}
+            else {sort(upper,end,depth);end=lower;}
+        }
+    }
+public:
+    KeyCluster(Table &table,uint64_t offset,uint8_t *scratch,Poll &p):t(table),at(offset),tmp(scratch),poll(p) {
