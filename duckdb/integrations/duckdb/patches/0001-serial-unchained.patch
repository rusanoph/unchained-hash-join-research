+// Measurement only: shape of the finished build side. Hashes are the engine's own (all key columns combined), so
+// distinct hashes approximate distinct key tuples for any key type; collisions at 64 bits are negligible.
+void JoinHashTable::HashmanCensus() {
+    auto &record=*hashman_record;
+    const auto started=std::chrono::steady_clock::now();
+    vector<hash_t> hashes;
+    hashes.reserve(Count());
+    if(Count()) {
+        TupleDataChunkIterator it(GetDataCollection(),TupleDataPinProperties::KEEP_EVERYTHING_PINNED,
+                                  0,GetDataCollection().ChunkCount(),false);
+        do {
+            if(context.IsInterrupted()) throw InterruptException();
+            auto locations=it.GetRowLocations();
+            for(idx_t i=0;i<it.GetCurrentChunkCount();++i) hashes.push_back(Load<hash_t>(locations[i]+pointer_offset));
+        } while(it.Next());
+    }
+    std::sort(hashes.begin(),hashes.end());
+    uint64_t distinct=0,max_run=0,ge8=0,ge16=0;
+    for(size_t i=0;i<hashes.size();) {
+        size_t j=i+1;
+        while(j<hashes.size() && hashes[j]==hashes[i]) ++j;
+        const uint64_t run=j-i;
+        ++distinct;max_run=MaxValue<uint64_t>(max_run,run);
+        if(run>=8) ge8+=run;
+        if(run>=16) ge16+=run;
+        i=j;
+    }
+    record.census=true;record.census_rows=hashes.size();record.census_distinct=distinct;record.census_max_dup=max_run;
+    record.census_rows_ge8=ge8;record.census_rows_ge16=ge16;record.census_entry_size=entry_size;
+    record.census_conditions=conditions.size();record.census_equality=equality_predicates.size();
+    record.census_support=HashmanSupportReason();record.census_join_type=JoinTypeToString(join_type);
+    string keys,payload;
+    for(auto &t:equality_types) keys+=(keys.empty()?"":",")+t.ToString();
+    for(auto &t:layout_ptr->GetTypes()) payload+=(payload.empty()?"":",")+t.ToString();
+    record.census_key_types=keys;record.census_payload_types=payload;
+    record.census_ns=std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now()-started).count();
+}
