+void JoinHashTable::BuildUnchained() {
+    const auto started = std::chrono::steady_clock::now();
+    const auto partition_mode=HashmanPartitionMode(context);
+    const bool partitioned_build=partition_mode==1 || (partition_mode==2 && uint64_t(Count())*entry_size>=HASHMAN_PARTITION_MIN_BYTES);
+    auto layout=HashmanLayout(context,Count(),entry_size,partitioned_build ? 16 : 0);
+    auto &allocator = buffer_manager.GetBufferAllocator();
+    AllocatedData cursors;
+    if(HashmanScratchBytes(layout)) cursors=allocator.Allocate(HashmanScratchBytes(layout));
+    auto next = make_uniq<HashmanTable>(allocator, layout,
+                                      HashmanBool(context, "hashman_bloom", true));
+    next->test_hash = HashmanTestHashMode(context);
+    next->probe_kernel = HashmanProbeSetting(context);
+    next->lookup_kernel = HashmanLookupSetting(context);
+    next->exact_ranges=HashmanBool(context,"hashman_exact_ranges",false);
+    const auto exact_lookup=HashmanExactLookupSetting(context);
+    next->exact_fused=exact_lookup.fused;next->refine_nodiv=exact_lookup.nodiv;next->refine_inline=exact_lookup.inlined;
+    if(exact_lookup.name!="separate" && !next->exact_ranges)
+        throw InvalidInputException("hashman_exact_lookup=%s requires exact ranges",exact_lookup.name);
+    if(next->exact_fused && next->lookup_kernel==HashmanLookupKernel::LEGACY)
+        throw InvalidInputException("hashman_exact_lookup=fused requires cached/tags lookup");
+    {   // Exact division is only valid for multiples of the stride; verify before use.
+        hashman_join::ExactDivisor divisor(layout.stride);
+        next->stride_shift=divisor.shift;next->stride_inverse=divisor.inverse;
+        for(uint64_t n:{uint64_t(0),uint64_t(1),uint64_t(7),uint64_t(65537),(uint64_t(1)<<40)+3})
+            if(divisor.divide(n*layout.stride)!=n) throw InternalException("Hashman exact stride division failed");
+    }
+    const auto refine_prefetch=HashmanRefinePrefetchSetting(context);
+    next->refine_pf_lookup=refine_prefetch.lookup;next->refine_pf_ahead=refine_prefetch.ahead;
+    if(refine_prefetch.name!="none" && (!next->exact_ranges || next->exact_fused))
+        throw InvalidInputException("hashman_refine_prefetch=%s requires exact ranges and a separate refine pass",refine_prefetch.name);
+    if(refine_prefetch.lookup && next->lookup_kernel==HashmanLookupKernel::LEGACY)
+        throw InvalidInputException("hashman_refine_prefetch=%s requires cached/tags lookup",refine_prefetch.name);
+    AllocatedData range_scratch;
+    if(next->exact_ranges)range_scratch=allocator.Allocate(layout.stride);
+    // Fault after both host allocations: RAII must release scratch and final storage.
+    if (HashmanTestSetting(context, "hashman_test_fault") == "allocation")
+        throw OutOfMemoryException("Hashman injected allocation failure before publication");
+    hashman_record->scratch_bytes=HashmanBuildScratch(context,layout);
+    hashman_record->SampleMemory(buffer_manager);
+    {
+        HashmanSpan span(hashman_record.get(),&HashmanRecord::core_ns);
+        if (partitioned_build) {
+            // The sink's partitions are usable when they are the top radix bits of the slot window: radix bits within the directory bits, no test hash, counts consistent.
+            vector<idx_t> from{0}, rows;
+            idx_t bits = 0;
+            const idx_t dir_bits = 64 - layout.shift;
+            if (hashman_part_bits >= 1 && hashman_part_bits <= dir_bits && next->test_hash == HashmanHashMode::NONE &&
+                hashman_part_chunks.size() == (idx_t(1) << hashman_part_bits)) {
+                idx_t row_sum = 0;
+                for (size_t p = 0; p < hashman_part_chunks.size(); ++p) {
+                    from.push_back(from.back() + hashman_part_chunks[p]);
+                    rows.push_back(hashman_part_rows[p]);
+                    row_sum += hashman_part_rows[p];
+                }
+                if (from.back() == GetDataCollection().ChunkCount() && row_sum == Count()) bits = hashman_part_bits;
+            }
+            if (!bits) {
+                from.assign(1, 0);
+                rows.clear();
+                from.push_back(GetDataCollection().ChunkCount());
+                rows.push_back(Count());
+            }
+            hashman_record->partition_bits = bits;
+            hashman_join::build_by_partitions(next->table, HashmanPartitionSource{*this, context, next->test_hash, from, rows, vector<uint8_t>(rows.size(), 0)}, unsigned(bits));
+        } else {
+            hashman_join::build(next->table, HashmanBuildSource{*this, context, next->test_hash,0},
+                               reinterpret_cast<uint64_t *>(cursors.get()));
+        }
+    }
+    if(next->exact_ranges) {
+        HashmanSpan span(hashman_record.get(),&HashmanRecord::key_clustering_ns);
+        HashmanKeyPoll poll(context,hashman_record->clustering_key_checks,hashman_record->profiled);
+        const auto at=layout_ptr->GetOffsets()[0];
+        if(equality_types[0].InternalType()==PhysicalType::INT32)
+            next->range_duplicate_keys=hashman_join::KeyCluster<int32_t,HashmanKeyPoll>(next->table,at,range_scratch.get(),poll).run();
+        else next->range_duplicate_keys=hashman_join::KeyCluster<int64_t,HashmanKeyPoll>(next->table,at,range_scratch.get(),poll).run();
+    }
+    data_collection->VerifyEverythingPinned();
+    // Build matching always emits a no-match selection. Probe may omit it.
+    auto probe_matcher = make_uniq<RowMatcher>();
+    probe_matcher->Initialize(false, *layout_ptr, equality_predicates);
+    auto no_match_probe_matcher = make_uniq<RowMatcher>();
+    no_match_probe_matcher->Initialize(true, *layout_ptr, equality_predicates);
+    // Publish only after every fallible allocation/initialization has succeeded.
+    row_matcher_probe = std::move(probe_matcher);
+    row_matcher_probe_no_match_sel = std::move(no_match_probe_matcher);
+    hashman_record->allocation_bytes = layout.bytes;
+    hashman_record->slots = layout.slots;
+    hashman_record->stride = layout.stride;
+    hashman_record->bloom = next->table.bloom;
+    hashman_table = std::move(next);
+    hashman_record->actual = "unchained_offsets_p1";
+    hashman_record->probe_kernel = HashmanProbeName(hashman_table->probe_kernel);
+    hashman_record->lookup_kernel = HashmanLookupName(hashman_table->lookup_kernel);
+    hashman_record->directory_format=layout.packed ? "packed48" : "offsets64";
+    hashman_record->variable_width=HashmanVariableWidth();
+    hashman_record->exact_ranges=hashman_table->exact_ranges;
+    hashman_record->exact_lookup=exact_lookup.name;
+    hashman_record->refine_prefetch=refine_prefetch.name;
+    hashman_record->partitioned_build=partitioned_build ? "aligned" : "off";
+    hashman_record->range_duplicate_keys=hashman_table->range_duplicate_keys;
+    hashman_record->reason = "executed";
+    chains_longer_than_one = !hashman_table->exact_ranges || hashman_table->range_duplicate_keys;
+    needs_chain_matcher = !hashman_table->exact_ranges;
+    finalized = true;
+    hashman_record->finalize_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(
+        std::chrono::steady_clock::now() - started).count();
+    GetHashmanState(context)->unchained_ready = true;
+}
