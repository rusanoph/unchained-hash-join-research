+string JoinHashTable::HashmanSupportReason() const {
+    if (join_type != JoinType::INNER) return "join_type_unsupported";
+    if (conditions.size() != 1 || equality_predicates.size() != 1 ||
+        equality_predicates[0] != ExpressionType::COMPARE_EQUAL) return "predicate_unsupported";
+    auto key = equality_types[0].InternalType();
+    if (key != PhysicalType::INT32 && key != PhysicalType::INT64) return "key_type_unsupported";
+    for (auto &type : layout_ptr->GetTypes()) {
+        auto physical = type.InternalType();
+        // VARCHAR/BLOB are string_t: short strings live in the row, long ones point into the engine's heap blocks. The row
+        // copy keeps the same pointers, so they stay valid exactly as long as the staging collection (and its heap) is retained.
+        if (!TypeIsIntegral(physical) && physical != PhysicalType::FLOAT &&
+            physical != PhysicalType::DOUBLE && physical != PhysicalType::BOOL && physical != PhysicalType::VARCHAR)
+            return "payload_type_unsupported";
+    }
+    return "eligible";
+}
+
+struct HashmanBuildSource {
+    JoinHashTable &ht;
+    ClientContext &context;
+    HashmanHashMode test_hash;
+    mutable unsigned pass;
+    template<class F> void each(F f) const {
+        HashmanSpan span(ht.hashman_record.get(), pass++==0 ? &HashmanRecord::count_ns : &HashmanRecord::scatter_ns);
+        if (!ht.Count()) return;
+        TupleDataChunkIterator it(ht.GetDataCollection(), TupleDataPinProperties::KEEP_EVERYTHING_PINNED,
+                                 0, ht.GetDataCollection().ChunkCount(), false);
+        do {
+            auto locations = it.GetRowLocations();
+            for (idx_t i = 0; i < it.GetCurrentChunkCount(); ++i) {
+                if ((i & 255) == 0 && context.IsInterrupted()) throw InterruptException();
+                f(HashmanTestHash(test_hash, Load<hash_t>(locations[i] + ht.pointer_offset)), locations[i]);
+            }
+        } while (it.Next());
+    }
+};
+
+// Partition-by-partition view of the build side after Unpartition(): the collection is the sink's partitions concatenated in order, so partition p is the chunk range
+// [from[p], from[p+1]) (recorded in HashmanCapturePartitions before the merge). Rows of a partition are read twice (count, scatter) while they are cache resident.
+struct HashmanPartitionSource {
+    JoinHashTable &ht;
+    ClientContext &context;
+    HashmanHashMode test_hash;
+    const vector<idx_t> &from;
+    const vector<idx_t> &rows;
+    mutable vector<uint8_t> pass;
+    uint64_t rows_in(size_t p) const { return rows[p]; }
+    template<class F> void each(size_t p, F f) const {
+        HashmanSpan span(ht.hashman_record.get(), pass[p]++==0 ? &HashmanRecord::count_ns : &HashmanRecord::scatter_ns);
+        if (from[p]==from[p+1]) return;
+        TupleDataChunkIterator it(ht.GetDataCollection(), TupleDataPinProperties::KEEP_EVERYTHING_PINNED, from[p], from[p+1], false);
+        do {
+            auto locations = it.GetRowLocations();
+            for (idx_t i = 0; i < it.GetCurrentChunkCount(); ++i) {
+                if ((i & 255) == 0 && context.IsInterrupted()) throw InterruptException();
+                f(HashmanTestHash(test_hash, Load<hash_t>(locations[i] + ht.pointer_offset)), locations[i]);
+            }
+        } while (it.Next());
+    }
+};
