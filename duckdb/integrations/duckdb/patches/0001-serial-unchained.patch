+#else
+#define HASHMAN_ALWAYS_INLINE inline
+#define HASHMAN_NOINLINE
+#endif
+// Same algorithm twice: the always-inline body for a caller that wants it in its
+// loop, and the out-of-line entry (v9 behaviour: a real call) that delegates to it.
+template<class Key,class Poll>
+HASHMAN_ALWAYS_INLINE Table::Range exact_key_range_inline(const Table &t,Table::Range prefix,uint64_t at,Key needle,Poll &poll) {
+    if(prefix.begin==prefix.end)return prefix;
