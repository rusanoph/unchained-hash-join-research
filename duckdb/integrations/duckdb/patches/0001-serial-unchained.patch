+namespace hashman_join {
+// Requires admitted signed scalar keys and immutable prefix bounds. Poll(true)
+// counts a full-key comparison; Poll(false) is only a cancellation heartbeat.
+template<class Key> inline Key range_key(const Table &t,uint64_t row,uint64_t key_at) {
+    Key result;std::memcpy(&result,t.rows+row*t.layout.stride+key_at,sizeof(result));return result;
+}
+template<class Key,class Poll> class KeyCluster {
+    Table &t;uint64_t at;uint8_t *tmp;Poll &poll;
+    bool less(Key a,Key b) {poll(true);return a<b;}
+    bool equal(Key a,Key b) {poll(true);return a==b;}
+    Key key(uint64_t i) const {return range_key<Key>(t,i,at);}
+    void swap(uint64_t a,uint64_t b) {
+        if(a==b)return;
+        auto p=t.rows+a*t.layout.stride,q=t.rows+b*t.layout.stride;
+        std::memcpy(tmp,p,t.layout.stride);std::memcpy(p,q,t.layout.stride);std::memcpy(q,tmp,t.layout.stride);
+    }
+    void sift(uint64_t base,uint64_t root,uint64_t count) {
+        while(root<count/2) {
+            auto child=root*2+1;
+            if(child+1<count && less(key(base+child),key(base+child+1)))++child;
+            if(!less(key(base+root),key(base+child)))return;
+            swap(base+root,base+child);root=child;
+        }
+    }
+    void heap(uint64_t begin,uint64_t end) {
+        auto count=end-begin;
