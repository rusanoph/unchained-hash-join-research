+// Measurement only: key order of the first 16 chunks of the staging collection (about 32k rows, well under a millisecond).
+void JoinHashTable::HashmanKeyOrder() {
+    if(!hashman_record || !Count() || equality_types.empty()) return;
+    const auto type=equality_types[0].InternalType();
+    if(type!=PhysicalType::INT32 && type!=PhysicalType::INT64) return;
+    const auto at=layout_ptr->GetOffsets()[0];
+    TupleDataChunkIterator it(GetDataCollection(), TupleDataPinProperties::KEEP_EVERYTHING_PINNED, 0, MinValue<idx_t>(16, GetDataCollection().ChunkCount()), false);
+    bool have=false;
+    int64_t previous=0;
+    uint64_t pairs=0, ascending=0;
+    do {
+        auto locations = it.GetRowLocations();
+        for (idx_t i = 0; i < it.GetCurrentChunkCount(); ++i) {
+            const int64_t key = type==PhysicalType::INT32 ? int64_t(Load<int32_t>(locations[i] + at)) : Load<int64_t>(locations[i] + at);
+            if(have) { ++pairs; ascending += key >= previous; }
+            previous = key; have = true;
+        }
+    } while (it.Next());
+    hashman_record->key_order_pairs = pairs;
+    hashman_record->key_order_ascending = ascending;
+}
+
+void JoinHashTable::HashmanCapturePartitions() {
+    hashman_part_chunks.clear();
+    hashman_part_rows.clear();
+    hashman_part_bits = 0;
+    if (!HashmanPartitionedBuildSetting(context) || !sink_collection) return;
+    auto &parts = sink_collection->GetPartitions();
+    hashman_part_bits = radix_bits;
+    for (auto &part : parts) {
+        hashman_part_chunks.push_back(part->ChunkCount());
+        hashman_part_rows.push_back(part->Count());
+    }
+}
