+void JoinHashTable::BuildHashmanRuntimeBloom() {
+    bloom_filter.Initialize(context,Count());
+    Vector hashes(LogicalType::HASH);
+    auto data=FlatVector::GetData<hash_t>(hashes);
+    TupleDataChunkIterator iterator(GetDataCollection(),TupleDataPinProperties::KEEP_EVERYTHING_PINNED,
+                                   0,GetDataCollection().ChunkCount(),false);
+    do {
+        if(context.IsInterrupted()) throw InterruptException();
+        auto locations=iterator.GetRowLocations();
+        const auto count=iterator.GetCurrentChunkCount();
+        for(idx_t i=0;i<count;++i) data[i]=Load<hash_t>(locations[i]+pointer_offset);
+        bloom_filter.InsertHashes(hashes,count);
+    } while(iterator.Next());
+    hashman_record->host_bloom=true;
+}
+
+void JoinHashTable::ReleaseHashmanStaging() {
+    if(!hashman_table || hashman_logical_count) throw InternalException("Invalid staging release state");
+    // Copied string_t values point into the staging heap: releasing it would leave dangling pointers.
+    if(HashmanVariableWidth()) throw InternalException("Staging release is invalid for variable-width rows");
+    // Only admitted fixed-width INNER rows: every payload/validity byte is copied.
+    // Reset preserves layout/gather functions; those read explicit B row pointers.
+    // Native runtime IN/Bloom materialization must already have finished.
+    const auto count=Count();
+    hashman_record->staging_before_release_bytes=SizeInBytes();
+    data_collection->Reset();
+    hashman_logical_count=count;
+    hashman_record->staging_released=true;
+    hashman_record->staging_bytes=0;
+    hashman_record->SampleMemory(buffer_manager);
+}
