+#pragma once
+// Build-side partitioned count/prefix/scatter for the packed48 layout (spike for the "build partitioning" difference to the paper, ledger limitation L15).
+// The result is BYTE-IDENTICAL to hashman_join::build() on the same source: partitioning is by the top `bits` bits of the hash, i.e. by a contiguous range of directory
+// buckets, it is stable (source order is kept inside a partition) and the in-bucket order of the reverse scatter is the same. Only the memory access pattern changes:
+// the random increments of the directory and the random row writes of the scatter stay inside one partition (a slice of the directory and one contiguous range of
+// the row area), which fits a cache level when `bits` is large enough.
+#include "hashman_kernel.hpp"
+#include <vector>
+
+namespace hashman_join {
+struct PartitionedInput {
+    unsigned bits = 0;
+    std::vector<uint64_t> begin;      // 2^bits + 1 row positions
+    std::vector<uint64_t> hashes;     // partition-ordered copy of the hashes
+    std::vector<uint8_t> rows;        // partition-ordered copy of the rows
+};
+// Paper Sec. 3.4: small tuples are copied with a few fixed-size loads/stores; a runtime stride turns every row copy into a library call.
+template<size_t FIXED> struct RowCopy {
+    static void copy(uint8_t *dst, const uint8_t *src, size_t) { std::memcpy(dst, src, FIXED); }
+};
+template<> struct RowCopy<0> {
+    static void copy(uint8_t *dst, const uint8_t *src, size_t stride) { std::memcpy(dst, src, stride); }
+};
+template<size_t FIXED>
+inline void copy_row(uint8_t *dst, const uint8_t *src, size_t stride) { RowCopy<FIXED>::copy(dst, src, stride); }
+inline uint64_t partition_of(uint64_t hash, unsigned bits, unsigned skip = 0) { return bits ? (hash << skip) >> (64 - bits) : 0; }
+inline unsigned log2_slots(const Layout &l) { return 64 - l.shift; }
+
+// Pass 1 + 2: histogram on the hash prefix, then stable scatter of (hash,row) into partition order. This is the work that a partitioned sink (the paper, or DuckDB's
+// radix-partitioned sink collection) would already have done while collecting tuples.
+template<size_t FIXED = 0, class Source>
+void partition_source(const Layout &layout, const Source &source, unsigned bits, PartitionedInput &out) {
+    if (bits > log2_slots(layout)) throw std::invalid_argument("more partition bits than directory bits");
+    if (bits > 20) throw std::invalid_argument("too many partitions");
+    out.bits = bits;
+    const size_t parts = size_t(1) << bits;
+    out.begin.assign(parts + 1, 0);
+    uint64_t seen = 0;
+    source.each([&](uint64_t hash, const uint8_t *) { ++out.begin[partition_of(hash, bits, layout.skip) + 1]; ++seen; });
+    if (seen != layout.count) throw std::runtime_error("build source cardinality changed");
+    for (size_t p = 0; p < parts; ++p) out.begin[p + 1] += out.begin[p];
+    out.hashes.resize(layout.count);
+    out.rows.resize(checked_mul(layout.count, layout.stride));
+    std::vector<uint64_t> cursor(out.begin.begin(), out.begin.end() - 1);
+    seen = 0;
+    source.each([&](uint64_t hash, const uint8_t *row) {
+        if (++seen > layout.count) throw std::runtime_error("partition source cardinality changed");
+        const auto pos = cursor[partition_of(hash, bits, layout.skip)]++;
+        out.hashes[pos] = hash;
+        copy_row<FIXED>(out.rows.data() + pos * layout.stride, row, layout.stride);
+    });
+    if (seen != layout.count) throw std::runtime_error("partition source cardinality changed");
